<idea-plugin>
    <id>com.helioncoder.jetbrains</id>
    <name>HelionCoder</name>
    <vendor>GabrielPondC</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends optional="true" config-file="com.helioncoder.jetbrains-withJava.xml">com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="HelionCoder"
            anchor="right"
            icon="/icons/helion.svg"
            factoryClass="com.helioncoder.jetbrains.HelionToolWindowFactory"/>
        <applicationConfigurable
            id="helionCoder.settings"
            displayName="HelionCoder"
            groupId="tools"
            instance="com.helioncoder.jetbrains.HelionSettingsConfigurable"/>
        <notificationGroup
            id="HelionCoder"
            displayType="BALLOON"/>
        <postStartupActivity
            implementation="com.helioncoder.jetbrains.completion.HelionCompletionStartupActivity"/>
    </extensions>

    <actions>
        <group id="HelionCoder.Menu" text="HelionCoder" icon="/icons/helion.svg" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action
                id="HelionCoder.OpenToolWindow"
                class="com.helioncoder.jetbrains.actions.OpenToolWindowAction"
                text="打开助手面板"
                icon="/icons/helion.svg"/>
            <action
                id="HelionCoder.Ask"
                class="com.helioncoder.jetbrains.actions.AskAction"
                text="询问 HelionCoder"
                icon="/icons/helion.svg"/>
            <action
                id="HelionCoder.ExplainSelection"
                class="com.helioncoder.jetbrains.actions.ExplainSelectionAction"
                text="解释选区"
                icon="/icons/helion.svg"/>
            <action
                id="HelionCoder.CompleteCode"
                class="com.helioncoder.jetbrains.actions.CompleteCodeAction"
                text="补全当前位置"
                icon="/icons/helion.svg"/>
            <action
                id="HelionCoder.ConfigureExecutable"
                class="com.helioncoder.jetbrains.actions.ConfigureExecutableAction"
                text="配置 CLI 可执行文件"
                icon="/icons/helion.svg"/>
        </group>
        <action
            id="HelionCoder.EditorCompleteCode"
            class="com.helioncoder.jetbrains.actions.CompleteCodeAction"
            text="HelionCoder 补全当前位置">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt BACK_SLASH"/>
        </action>
    </actions>
</idea-plugin>
